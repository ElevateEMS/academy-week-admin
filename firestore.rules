rules_version = '2';

// Only Bella and Nick can read or write anything. Keep this list the same
// as STAFF_EMAILS in config.js and Code.gs.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['gbrown@elevateemsacademy.com', 'nbrown@elevateemsacademy.com'];
    }
    match /{document=**} {
      allow read, write: if isStaff();
    }
  }
}
